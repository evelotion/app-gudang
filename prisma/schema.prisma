generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  inisial   String   @unique
  nama      String
  password  String
  role      String   @default("STAF") // ADMIN atau STAF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODUL MANAJEMEN ASET
// ==========================================

model RegistrasiAset {
  id                  String   @id @default(cuid())
  tanggalInput        DateTime @default(now()) // <--- TAMBAHAN UNTUK BATCH DATE
  nomorRegisterAset   String   @unique
  namaAset            String
  golonganAset        String
  jumlah              Int
  tanggalPerolehan    DateTime
  hargaPerolehan      Decimal  @db.Decimal(15, 2)
  cabangUnitKerja     String
  userPengguna        String
  lokasiPosisiAset    String
  
  // Track Records
  status              String   @default("PENDING") // PENDING, APPROVED, REJECTED
  inputerName         String   
  supervisorName      String?  
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model HapusBukuAset {
  id                  String   @id @default(cuid())
  tanggalInput        DateTime @default(now()) // <--- TAMBAHAN UNTUK BATCH DATE
  tanggalHapusBuku    DateTime
  nomorRegisterAset   String   
  namaAset            String
  golonganAset        String
  jumlah              Int
  tanggalPerolehan    DateTime
  hargaPerolehan      Decimal  @db.Decimal(15, 2)
  akmPenyusutan       Decimal  @db.Decimal(15, 2)
  nilaiBuku           Decimal  @db.Decimal(15, 2)
  cabangUnitKerja     String
  alasanHapusBuku     String
  
  // Track Records
  status              String   @default("PENDING")
  operatorName        String
  supervisorName      String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
model MutasiAset {
  id                  String   @id @default(cuid())
  tanggalInput        DateTime @default(now())
  tanggalMutasi       DateTime
  nomorRegisterAset   String   
  namaAset            String
  golonganAset        String
  jumlah              Int
  tanggalPerolehan    DateTime
  hargaPerolehan      Decimal  @db.Decimal(15, 2)
  akmPenyusutan       Decimal  @db.Decimal(15, 2)
  lokasiAwal          String
  lokasiTujuan        String
  alasanMutasi        String
  
  // Track Records
  status              String   @default("PENDING")
  operatorName        String
  supervisorName      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}